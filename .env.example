# Sentinel — Environment Variables Template
# Copy to .env.local and fill in your values
# DO NOT put real values here — this file is committed to version control

# Application
NODE_ENV=
PORT=
APP_URL=

# Database
DATABASE_URL=
VECTOR_STORE_URL=

# Authentication
AUTH_SECRET=
AUTH_URL=

# Agent Runtime
AGENT_RUNTIME_URL=
AGENT_MAX_CONCURRENT=
AGENT_TIMEOUT_MS=

# Environmental Data Sources
EARTH_OBSERVATION_API_KEY=
EARTH_OBSERVATION_API_URL=
CLIMATE_DATA_API_KEY=
CLIMATE_DATA_API_URL=
GEOSPATIAL_API_KEY=
GEOSPATIAL_API_URL=

# Observability
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=
LOG_LEVEL=

# AI / LLM Provider
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Object Storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
